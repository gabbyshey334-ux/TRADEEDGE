NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required server-side for the Stripe webhook (do NOT expose to the client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — trial email sequence (server-side only). https://resend.com
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=TradeEdge AI <noreply@tradeedgeapp.net>

# Auth emails (signup confirm, password reset) are sent by Supabase Auth, NOT
# by RESEND_API_KEY above, unless you enable Custom SMTP in the Supabase
# dashboard (Authentication → Email → SMTP Settings) using Resend:
#   Host: smtp.resend.com  Port: 465  User: resend  Pass: your RESEND_API_KEY
# Built-in Supabase SMTP is capped at ~2 emails/hour and causes
# "email rate limit exceeded" (HTTP 429) on forgot-password / signup.

# Optional: protect /api/email/send-sequence (Vercel Cron sends Bearer CRON_SECRET)
# CRON_SECRET=your_cron_secret

# Manual-only admin backfill for trial email catch-up (x-admin-secret header).
# Do NOT add this to vercel.json crons.
# ADMIN_BACKFILL_SECRET=your_long_random_secret

# Anthropic Claude — powers the AI Coach reports. Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Financial Modeling Prep — powers the live Congressional Trades feed.
# Get a key from https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# Stripe — get these from https://dashboard.stripe.com (test mode).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
